+/*
+ * Aegisub extension: optional per-glyph boxes for masking subtitle text in
+ * the video preview. Collection is off by default and has no effect on
+ * rendering; the returned array stays valid until the next render call.
+ */
+typedef struct ass_glyph_box {
+    int x, y, w, h;             /* Glyph bitmap box in frame coordinates */
+    const char *event_text;     /* ASS_Event.Text this glyph came from */
+    size_t text_offset;         /* Byte offset into event_text */
+    size_t text_length;         /* Byte length in event_text */
+    int is_drawing;             /* Nonzero for \p drawing glyphs */
+} ASS_GlyphBox;
+
+/* Enable or disable collection. Enabling discards previously collected boxes. */
+void ass_set_glyph_box_collection(ASS_Renderer *priv, int enabled);
+
+/* Return the number of boxes collected for the last rendered frame. */
+int ass_get_glyph_boxes(ASS_Renderer *priv, ASS_GlyphBox **boxes);
